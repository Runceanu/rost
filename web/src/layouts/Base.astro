---
import '../../../tokens/tokens.css'
import '../../../tokens/fonts.css'
import '../styles/site.css'
import Logo from '../components/Logo.astro'
import { Button } from '../../../src/components/button/Button'
import { groups, title, inCode, GITHUB } from '../lib/kit'

interface Props { title: string; description?: string; current?: string; sidebar?: boolean }
const { title: pageTitle, description = 'Rost started as a design system for my own needs and grew into a product of its own. Today it serves products across different industries.', current = '', sidebar = false } = Astro.props
const path = Astro.url.pathname
// The top nav uses Rost's Button, as runceanu.com's does: Tertiary for the
// sections, Secondary for GitHub. The page you're on is the disabled
// Tertiary, the way runceanu.com marks it; inside a section the link stays.
const NAV: [string, string][] = [['/components/', 'Components'], ['/tokens/', 'Tokens'], ['/icons/', 'Icons'], ['/docs/contract/', 'Docs']]
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap" />
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <header class="top">
      <a class="brand" href="/" aria-current={path === '/' ? 'page' : undefined}><Logo /><span>Rost</span></a>
      <nav class="top-nav" aria-label="Main">
        {NAV.map(([href, label]) => path === href
          ? <span aria-current="page"><Button as="span" variant="tertiary" disabled>{label}</Button></span>
          : <Button variant="tertiary" href={href}>{label}</Button>)}
        <Button variant="secondary" href={GITHUB} className="gh" target="_blank" rel="noreferrer">GitHub</Button>
      </nav>
    </header>
    {sidebar ? (
      <div class="shell">
        <nav class="side" aria-label="Components">
          {groups.map(([, label, list]) => (
            <div class="side-group">
              <div class="side-title">{label}</div>
              {list.map((e) => (
                <a href={`/components/${e.id}/`} aria-current={e.id === current ? 'page' : undefined}>
                  <span>{title(e)}</span>
                  {inCode(e.id) && <span class="dot"><span class="sr-only">Built in code</span></span>}
                </a>
              ))}
            </div>
          ))}
        </nav>
        <main class="main" id="content">{current && <a class="back" href="/components/">&larr; All components</a>}<slot /></main>
      </div>
    ) : (
      <main class="page" id="content"><slot /></main>
    )}
    <footer class="foot">
      <span>Rost serves products across different industries.</span>
      <a href={GITHUB} target="_blank" rel="noreferrer">GitHub</a>
    </footer>
  </body>
</html>
