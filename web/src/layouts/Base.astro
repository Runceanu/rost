---
import '../../../tokens/tokens.css'
import '../styles/site.css'
import { kit, KINDS, title, inCode, GITHUB } from '../lib/kit'

interface Props { title: string; description?: string; current?: string; sidebar?: boolean }
const { title: pageTitle, description = 'Rost started as a design system for my own needs and grew into a product of its own. Today it serves products across different industries.', current = '', sidebar = false } = Astro.props
const groups = KINDS.filter(([k]: [string, string]) => kit.some((e) => e.kind === k))
const path = Astro.url.pathname
const navActive = (prefix: string) => (path.startsWith(prefix) ? 'is-active' : '')
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=general-sans@400,500,600&display=swap" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap" />
  </head>
  <body>
    <header class="top">
      <a class="brand" href="/"><img src="/favicon.svg" alt="" width="22" height="22" /><span>Rost</span></a>
      <nav class="top-nav" aria-label="Main">
        <a href="/components/" class={navActive('/components')}>Components</a>
        <a href="/tokens/" class={navActive('/tokens')}>Tokens</a>
        <a href="/icons/" class={navActive('/icons')}>Icons</a>
        <a href="/docs/contract/" class={navActive('/docs')}>Docs</a>
        <a href={GITHUB} class="gh" target="_blank" rel="noreferrer">GitHub</a>
      </nav>
    </header>
    {sidebar ? (
      <div class="shell">
        <aside class="side" aria-label="Components">
          {groups.map(([k, label]: [string, string]) => (
            <div class="side-group">
              <div class="side-title">{label}</div>
              {kit.filter((e) => e.kind === k).map((e) => (
                <a href={`/components/${e.id}/`} class={e.id === current ? 'is-active' : ''}>
                  <span>{title(e)}</span>
                  {inCode(e.id) && <span class="dot" title="Built in code" />}
                </a>
              ))}
            </div>
          ))}
        </aside>
        <main class="main">{current && <a class="back" href="/components/">&larr; All components</a>}<slot /></main>
      </div>
    ) : (
      <main class="page"><slot /></main>
    )}
    <footer class="foot">
      <span>Rost. My design system, behind runceanu.com and akount.ing.</span>
      <a href={GITHUB} target="_blank" rel="noreferrer">GitHub</a>
    </footer>
  </body>
</html>
