---
import '../../../tokens/tokens.css'
import '../../../tokens/fonts.css'
import '../styles/site.css'
import Logo from '../components/Logo.astro'
import { Button } from '../../../src/components/button/Button'
import { Tooltip } from '../../../src/components/tooltip/Tooltip'
import { ListItem } from '../../../src/components/list-item/ListItem'
import { ThemeSwitch } from '../components/ThemeSwitch'
import { groups, title, attention, GITHUB } from '../lib/kit'

interface Props { title: string; description?: string; current?: string; sidebar?: boolean; sideLabel?: string }
const { title: pageTitle, description = 'Rost started as a design system for my own needs and grew into a product of its own. Today it serves products across different industries.', current = '', sidebar = false, sideLabel = 'Components' } = Astro.props
// A page can bring its own sidebar list (the docs do); otherwise it's the components.
const ownSide = Astro.slots.has('side')
const path = Astro.url.pathname
// The top nav uses Rost's Button, as the portfolio site's does: Tertiary for the
// sections, Secondary for GitHub. The page you're on wears the pressed look
// (aria-current) and isn't a link, with a tooltip saying why; inside a
// section the link stays.
const NAV: [string, string][] = [['/components/', 'Components'], ['/tokens/', 'Tokens'], ['/icons/', 'Icons'], ['/docs/contract/', 'Docs']]
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap" />
    <script is:inline>
      // Before anything paints: the theme you picked last time, if you picked one.
      // Without one there's no data-theme, and tokens.css stays dark.
      try { const t = localStorage.getItem('rost-theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <header class="top">
      <a class="brand" href="/" aria-current={path === '/' ? 'page' : undefined}><Logo /><span>Rost</span></a>
      <div class="top-end">
        <nav class="top-nav" aria-label="Main">
          {NAV.map(([href, label]) => path === href
            ? <span class="here" aria-describedby="here-tip"><Button as="span" variant="tertiary" aria-current="page">{label}</Button><Tooltip id="here-tip">You're already here</Tooltip></span>
            : <Button variant="tertiary" href={href}>{label}</Button>)}
          <Button variant="secondary" href={GITHUB} className="gh" target="_blank" rel="noreferrer">GitHub</Button>
        </nav>
        <ThemeSwitch />
      </div>
    </header>
    {sidebar ? (
      <div class="shell">
        <nav class="side" aria-label={sideLabel}>
          <div class="side-scroll">
            {ownSide ? <slot name="side" /> : groups.map(([, label, list]) => (
              <div class="side-group">
                <div class="side-title">{label}</div>
                {list.map((e) => {
                  // A dot only when something needs looking at; hovering it says what.
                  const a = attention(e)
                  return (
                    <span class="side-row">
                      <ListItem href={`/components/${e.id}/`} selected={e.id === current} aria-current={e.id === current ? 'page' : undefined} badge={!!a} badgeStatus={a?.status}>
                        {title(e)}{a && <span class="sr-only">: {a.why.join('. ')}</span>}
                      </ListItem>
                      {a && <Tooltip aria-hidden="true">{a.why.join('. ')}</Tooltip>}
                    </span>
                  )
                })}
              </div>
            ))}
          </div>
          <span class="side-thumb" aria-hidden="true"></span>
        </nav>
        <main class="main" id="content">{current && <a class="back" href="/components/">&larr; All components</a>}<slot /></main>
      </div>
    ) : (
      <main class="page" id="content"><slot /></main>
    )}
    <footer class="foot">
      <span>Rost serves products across different industries.</span>
      <a href={GITHUB} target="_blank" rel="noreferrer">GitHub</a>
    </footer>
    <script>
      // The sidebar's scrollbar floats over the rows instead of taking 12px
      // beside them: a thumb that follows the list, shows on hover and while
      // scrolling, and can be dragged.
      for (const side of document.querySelectorAll<HTMLElement>('.side')) {
        const list = side.querySelector<HTMLElement>('.side-scroll')!
        const thumb = side.querySelector<HTMLElement>('.side-thumb')!
        let hide = 0
        const place = () => {
          const { scrollTop, scrollHeight, clientHeight } = list
          const fits = scrollHeight <= clientHeight
          side.classList.toggle('side--fits', fits)
          if (fits) return
          const h = Math.max(32, (clientHeight / scrollHeight) * clientHeight)
          thumb.style.height = `${h}px`
          thumb.style.transform = `translateY(${(scrollTop / (scrollHeight - clientHeight)) * (clientHeight - h)}px)`
        }
        list.addEventListener('scroll', () => {
          place()
          side.classList.add('side--scrolling')
          clearTimeout(hide)
          hide = window.setTimeout(() => side.classList.remove('side--scrolling'), 800)
        }, { passive: true })
        thumb.addEventListener('pointerdown', (ev) => {
          const y = ev.clientY, top = list.scrollTop
          const ratio = (list.scrollHeight - list.clientHeight) / (list.clientHeight - thumb.offsetHeight)
          thumb.setPointerCapture(ev.pointerId)
          side.classList.add('side--dragging')
          const move = (e: PointerEvent) => { list.scrollTop = top + (e.clientY - y) * ratio }
          const up = () => { side.classList.remove('side--dragging'); thumb.removeEventListener('pointermove', move); thumb.removeEventListener('pointerup', up) }
          thumb.addEventListener('pointermove', move)
          thumb.addEventListener('pointerup', up)
        })
        new ResizeObserver(place).observe(list)
        place()
      }
    </script>
    <script>
      // Light or dark. The switch says what it will do, flips data-theme on
      // <html> and remembers it. Until you use it the site is dark.
      const html = document.documentElement
      const current = () => (html.dataset.theme === 'light' ? 'light' : 'dark')
      const changed = () => {
        const next = current() === 'light' ? 'dark' : 'light'
        for (const b of document.querySelectorAll<HTMLElement>('[data-theme-switch]')) b.setAttribute('aria-label', `Switch to the ${next} theme`)
        dispatchEvent(new Event('rost-theme'))
      }
      for (const b of document.querySelectorAll<HTMLElement>('[data-theme-switch]'))
        b.addEventListener('click', () => {
          html.dataset.theme = current() === 'light' ? 'dark' : 'light'
          try { localStorage.setItem('rost-theme', html.dataset.theme) } catch {}
          changed()
        })
      changed()
    </script>
    <script>
      // The Paper effect's previews are canvases; paper.ts draws on them. It
      // reads its colours once, so a new theme mounts it again.
      import { mountPaper } from '../../../src/effects/paper'
      let stops: (() => void)[] = []
      const mount = () => {
        stops.forEach((stop) => stop())
        stops = [...document.querySelectorAll<HTMLCanvasElement>('canvas[data-paper-preview]')].map((c) => mountPaper(c, { area: c.parentElement }))
      }
      mount()
      addEventListener('rost-theme', mount)
    </script>
  </body>
</html>
