---
import Base from '../../layouts/Base.astro'
import { md, readRepo, GITHUB } from '../../lib/kit'
import { DOCS } from '../../lib/docs'

export function getStaticPaths() {
  return Object.keys(DOCS).map((slug) => ({ params: { slug } }))
}

const { slug } = Astro.params as { slug: keyof typeof DOCS }
const doc = DOCS[slug]
// docs/CONTRACT.md -> /docs/contract/, and the docs index is the home page.
const route: Record<string, string> = { 'README.md': '/', ...Object.fromEntries(Object.entries(DOCS).map(([s, d]) => [d.file.replace(/^docs\//, ''), `/docs/${s}/`])) }

// Links in the markdown point at files in the repo. On the site, a component
// page or a doc goes to its page here, and anything else goes to GitHub.
const fix = (href: string) => {
  if (/^(https?:|#|mailto:)/.test(href)) return href
  // Keep the anchor: CONTRACT.md#the-freeze lands on the same heading here.
  const [path, hash = ''] = href.replace(/^\.\//, '').split('#')
  const anchor = hash && `#${hash}`
  const comp = path.match(/^components\/([a-z0-9-]+)\.md$/)
  if (comp) return `/components/${comp[1]}/${anchor}`
  if (route[path]) return route[path] + anchor
  // Anything else is a file in the repo. Paths are relative to docs/.
  const repoPath = path.startsWith('../') ? path.slice(3) : `docs/${path}`
  return `${GITHUB}/blob/master/${repoPath}${anchor}`
}
const html = md(readRepo(doc.file).replace(/^<!--[\s\S]*?-->\s*/, ''))
  .replace(/href="([^"]+)"/g, (_, h) => `href="${fix(h)}"`)
---
<Base title={`${doc.title} · Rost`}>
  <div class="docs">
    <nav class="doc-nav" aria-label="Docs">
      {Object.entries(DOCS).map(([s, d]) => <a href={`/docs/${s}/`} aria-current={s === slug ? 'page' : undefined}>{d.title}</a>)}
    </nav>
    <article class="prose" set:html={html} />
  </div>
</Base>
<style>
  .docs { display: grid; gap: var(--spacing-gap-xlarge); grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 960px) { .docs { grid-template-columns: 200px minmax(0, 1fr); } }
  .doc-nav { display: flex; flex-wrap: wrap; gap: var(--spacing-gap-xsmall); align-self: start; }
  @media (min-width: 960px) { .doc-nav { flex-direction: column; position: sticky; top: calc(var(--header) + var(--spacing-gap-large)); } }
  .doc-nav a { text-decoration: none; color: var(--fg-3); font-size: 14px; padding: var(--spacing-gap-xsmall) var(--spacing-gap-small); border-radius: var(--spacing-radius-small); }
  .doc-nav a:hover, .doc-nav a[aria-current] { color: var(--fg); background: var(--surface); }
  .prose :global(h1) { color: var(--fg); }
  .prose :global(h2) { font-family: var(--body); font-size: 24px; letter-spacing: -.02em; text-transform: none; color: var(--fg); margin: var(--spacing-gap-3xlarge) 0 var(--spacing-gap-small); font-weight: 600; }
  .prose :global(h3) { margin: var(--spacing-gap-xlarge) 0 var(--spacing-gap-small); }
  .prose :global(code) { color: var(--fg); }
  .prose :global(li) { margin: var(--spacing-gap-2xsmall) 0; }
</style>
