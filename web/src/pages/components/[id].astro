---
import Base from '../../layouts/Base.astro'
import ComponentDetail from '../../components/ComponentDetail.astro'
import { kit, byId, title, partsOf } from '../../lib/kit'

// A part (a tab-item) has no page of its own: it's shown under the one it
// belongs to.
export function getStaticPaths() {
  return kit.filter((e) => !e.c.partOf).map((e) => ({ params: { id: e.id } }))
}

const { id } = Astro.params as { id: string }
const e = byId(id)
const parts = partsOf(id)
---
<Base title={`${title(e)} · Rost`} description={e.c.summary} current={id} sidebar>
  <ComponentDetail id={id} />
  {parts.map((p: any) => <section class="part"><ComponentDetail id={p.id} nested /></section>)}
</Base>

<script>
  // Tabs as the ARIA pattern has them: click or arrow keys to move, and only
  // the selected tab sits in the tab order.
  for (const box of document.querySelectorAll('[data-tabs]')) {
    // Only the page's own Preview/Code tabs, not the ones inside a preview.
    const tabs = [...box.querySelectorAll<HTMLButtonElement>(':scope > .tab-bar [role="tab"]')]
    const select = (tab: HTMLButtonElement) => {
      for (const t of tabs) {
        const on = t === tab
        t.setAttribute('aria-selected', String(on))
        t.classList.toggle('rost-tab-item--selected', on)
        t.tabIndex = on ? 0 : -1
        document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on
      }
    }
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(t))
      t.addEventListener('keydown', (ev) => {
        const step = ev.key === 'ArrowRight' ? 1 : ev.key === 'ArrowLeft' ? -1 : 0
        const to = ev.key === 'Home' ? tabs[0] : ev.key === 'End' ? tabs.at(-1) : step ? tabs[(i + step + tabs.length) % tabs.length] : null
        if (!to) return
        ev.preventDefault()
        select(to)
        to.focus()
      })
    })
  }
</script>


<style>
  .part { margin-top: var(--spacing-gap-4xlarge); padding-top: var(--spacing-gap-2xlarge); border-top: 1px solid var(--line); }
</style>
