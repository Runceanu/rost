---
import Base from '../../layouts/Base.astro'
import { Code } from 'astro:components'
import { Fixtures, fixturesFor } from '../../components/Fixtures'
import { kit, byId, title, inCode, guidanceHtml, componentSource, sourceLink, tokenCell, isColour, APP_LABEL, GITHUB } from '../../lib/kit'
import { shotsFor } from '../../lib/shots'
import { Badge } from '../../../../src/components/badge/Badge'
import { Tag } from '../../../../src/components/tags/Tag'

export function getStaticPaths() {
  return kit.map((e) => ({ params: { id: e.id } }))
}

const { id } = Astro.params as { id: string }
const e = byId(id)
const c = e.c
const g = e.guidance
const built = inCode(id)
const src = sourceLink(c)
const source = componentSource(id)
const usage = fixturesFor(id)?.usage

const { shots: figma, blanks } = built ? { shots: [], blanks: 0 } : shotsFor(id)

// The same words the markdown docs use, with a colour for each kind.
const CELL: Record<string, string> = { token: 'tk', suggested: 'tk--warn', layout: 'tk--none', sample: 'tk--none', reasoned: 'tk--none', gap: 'tk--gap' }
const cell = (prop: string, v: any) => { const t = tokenCell(prop, v); return { cls: CELL[t.kind] ?? 'tk--gap', text: t.text } }
const fixed = Object.entries(e.invariants).flatMap(([part, props]: [string, any]) => Object.entries(props).map(([prop, v]: [string, any]) => ({ part, prop, v })))
const byProp: Record<string, { name: string; v: any }[]> = {}
for (const [name, parts] of Object.entries(e.variantMap) as [string, any][])
  for (const [part, props] of Object.entries(parts) as [string, any][])
    for (const [prop, v] of Object.entries(props)) (byProp[`${part}.${prop}`] ??= []).push({ name, v })
const props = Object.entries(c.props ?? {}) as [string, any][]
---
<Base title={`${title(e)} · Rost`} description={c.summary} current={id} sidebar>
  <div class="kicker">{e.kind}</div>
  <h1>{title(e)}</h1>
  {c.summary && <p class="lede">{c.summary}</p>}
  <div class="meta">
    <Badge status={built ? 'positive' : 'default'}>{built ? 'In code' : 'Not in code yet'}</Badge>
    <Badge status={c.status === 'stable' ? 'positive' : 'default'}>Contract: {c.status}</Badge>
    <Badge status={g?.status === 'agreed' ? 'positive' : g ? 'warning' : 'default'}>Guidance: {g?.status ?? 'none yet'}</Badge>
    <Tag href={`${GITHUB}/blob/master/contracts/${e.file}`} target="_blank" rel="noreferrer">Contract on GitHub</Tag>
    {src.href && <Tag href={src.href} target="_blank" rel="noreferrer">{src.label}</Tag>}
  </div>

  {built ? (
    <section class="tabs" data-tabs>
      <div class="tab-bar" role="tablist" aria-label={`${title(e)} preview and code`}>
        <button type="button" role="tab" id="tab-preview" aria-controls="panel-preview" aria-selected="true" tabindex="0">Preview</button>
        <button type="button" role="tab" id="tab-code" aria-controls="panel-code" aria-selected="false" tabindex="-1">Code</button>
      </div>
      <div class="tab-panel" role="tabpanel" id="panel-preview" aria-labelledby="tab-preview" tabindex="0"><div class="stage"><Fixtures id={id} /></div></div>
      <div class="tab-panel" role="tabpanel" id="panel-code" aria-labelledby="tab-code" tabindex="0" hidden>
        {usage && <Code code={usage} lang={e.kind === 'effect' ? 'css' : 'tsx'} theme="vesper" />}
        {source && (
          <details class="source">
            <summary>{source.file}</summary>
            <Code code={source.code} lang="tsx" theme="vesper" />
          </details>
        )}
      </div>
    </section>
  ) : blanks > 0 && figma.length === 0 ? (
    <p class="note">Figma's renders of this one came back empty, so there's nothing to show yet. The contract below is complete. I'll capture the pictures again next time I have Figma open.</p>
  ) : figma.length === 0 && !e.kind.startsWith('effect') && e.kind !== 'pattern' ? (
    <p class="note">Figma's renders of this one have real people's photos in them, so they stay off the site. The contract below is complete.</p>
  ) : figma.length > 0 && (
    <section>
      <div class="stage">
        <div class="fixtures">
          {figma.map((v) => (
            <figure class="fixture">
              <div class="fixture-stage"><img class="shot" src={v.url} alt={`${title(e)}, ${v.name}, as drawn in Figma`} loading="lazy" /></div>
              <figcaption>{v.name.replace(/[a-z]+=/gi, '').replace(/, /g, ' · ')}</figcaption>
            </figure>
          ))}
        </div>
      </div>
      <p class="note">These are Figma's own renders. It isn't built in code yet. The contract below is what I'll build it from.</p>
    </section>
  )}

  {g && <div class="prose" set:html={guidanceHtml(g)} />}

  {props.length > 0 && (
    <>
      <h2>Props</h2>
      <div class="scroll"><table class="t">
        <thead><tr><th>Prop</th><th>Type</th><th>Values</th><th>Default</th></tr></thead>
        <tbody>{props.map(([k, v]) => <tr><td>{k}</td><td>{v.type}</td><td>{(v.values ?? []).join(' · ')}</td><td>{v.default !== undefined ? String(v.default) : ''}</td></tr>)}</tbody>
      </table></div>
    </>
  )}
  {c.states?.length > 0 && <p class="muted">States: {c.states.join(', ')}.</p>}

  {e.implementations.length > 0 && (
    <>
      <h2>Where it's used</h2>
      <ul class="plain">{e.implementations.map((i: any) => <li><b>{APP_LABEL[i.app] ?? i.app}</b> <code>{i.component}</code>{i.root && <> <code>{i.root}</code></>}</li>)}</ul>
    </>
  )}
  {e.deviations.length > 0 && (
    <>
      <h2>Where code differs on purpose</h2>
      <ul class="plain">{e.deviations.map((d: any) => <li><b>{APP_LABEL[d.app] ?? d.app ?? 'Everywhere'}:</b> {d.what} <span class="muted">{d.why}</span></li>)}</ul>
    </>
  )}

  <h2>Values</h2>
  <p class="muted">Straight from the contract. Each value sits next to its token, because six tokens here all come out as <code>#3a3a3a</code> and the colour alone can't tell you which one is right.</p>
  <h3>Never changes</h3>
  <div class="scroll"><table class="t">
    <thead><tr><th>Part</th><th>Property</th><th>Value</th><th>Token</th></tr></thead>
    <tbody>{fixed.map(({ part, prop, v }) => { const t = cell(prop, v); return <tr><td>{part}</td><td>{prop}</td><td>{isColour(v.value) && <span class="sw" style={`--c:${v.value}`} />}{v.value}</td><td class={t.cls}>{t.text}</td></tr> })}</tbody>
  </table></div>
  {Object.keys(byProp).length > 0 && (
    <>
      <h3>Changes by variant</h3>
      {Object.entries(byProp).sort().map(([k, rows]) => (
        <details class="vary">
          <summary><code>{k}</code><span class="n">{rows.length}</span></summary>
          <div class="scroll"><table class="t"><tbody>{rows.map(({ name, v }) => { const t = cell(k.split('.')[1], v); return <tr><td>{name}</td><td>{isColour(v.value) && <span class="sw" style={`--c:${v.value}`} />}{v.value}</td><td class={t.cls}>{t.text}</td></tr> })}</tbody></table></div>
        </details>
      ))}
    </>
  )}
</Base>

<script>
  // Tabs as the ARIA pattern has them: click or arrow keys to move, and only
  // the selected tab sits in the tab order.
  for (const box of document.querySelectorAll('[data-tabs]')) {
    const tabs = [...box.querySelectorAll<HTMLButtonElement>('[role="tab"]')]
    const select = (tab: HTMLButtonElement) => {
      for (const t of tabs) {
        const on = t === tab
        t.setAttribute('aria-selected', String(on))
        t.tabIndex = on ? 0 : -1
        document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on
      }
    }
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(t))
      t.addEventListener('keydown', (ev) => {
        const step = ev.key === 'ArrowRight' ? 1 : ev.key === 'ArrowLeft' ? -1 : 0
        const to = ev.key === 'Home' ? tabs[0] : ev.key === 'End' ? tabs.at(-1) : step ? tabs[(i + step + tabs.length) % tabs.length] : null
        if (!to) return
        ev.preventDefault()
        select(to)
        to.focus()
      })
    })
  }
</script>

<style>
  .tabs { margin: var(--spacing-gap-small) 0; }
  /* Plain tabs until Rost has a Tabs component (it isn't designed in Figma yet). */
  .tab-bar { display: flex; gap: var(--spacing-gap-2xsmall); margin-bottom: var(--spacing-gap-small-medium); }
  .tab-bar button { font: inherit; font-size: 14px; color: var(--fg-3); background: none; border: 1px solid transparent; border-radius: var(--spacing-radius-full); padding: var(--spacing-gap-xsmall) var(--spacing-gap-small-medium); cursor: pointer; }
  .tab-bar button[aria-selected='true'] { color: var(--fg); background: var(--surface); border-color: var(--line); }
  .stage { background: var(--ground); border: 1px solid var(--line); border-radius: var(--spacing-radius-large); padding: var(--spacing-gap-xlarge); overflow-x: auto; }
  @media (max-width: 520px) { .stage { padding: var(--spacing-gap-medium-large); } }
  .source { margin-top: var(--spacing-gap-small-medium); }
  .source summary { cursor: pointer; color: var(--fg-3); font-family: var(--mono); font-size: 12.5px; margin-bottom: var(--spacing-gap-small); }
  .note { color: var(--fg-3); font-size: 13.5px; margin: var(--spacing-gap-small) 0 0; }
  .plain { padding-left: var(--spacing-gap-medium-large); color: var(--fg-2); }
  .plain li { margin: var(--spacing-gap-2xsmall) 0; }
  .vary { margin: 0 0 var(--spacing-gap-small); }
  .vary summary { cursor: pointer; display: flex; align-items: center; gap: var(--spacing-gap-small); padding: var(--spacing-gap-xsmall) 0; color: var(--fg); list-style: none; }
  .vary summary::-webkit-details-marker { display: none; }
  /* display: flex drops the native triangle, so it's drawn back. */
  .vary summary::before { content: ''; width: 0; height: 0; border-left: 5px solid var(--fg-3); border-block: 4px solid transparent; transition: transform .15s; }
  .vary[open] summary::before { transform: rotate(90deg); }
  .vary .n { font-family: var(--mono); font-size: 11px; color: var(--fg-3); background: var(--surface); padding: 1px var(--spacing-gap-small); border-radius: var(--spacing-radius-full); }
  .tk--warn { color: var(--warn); }
  :global(.fixtures) { display: flex; flex-wrap: wrap; gap: var(--spacing-gap-large) var(--spacing-gap-2xlarge); align-items: flex-end; }
  :global(.fixture) { margin: 0; display: flex; flex-direction: column; gap: var(--spacing-gap-small); align-items: flex-start; max-width: 100%; min-width: 0; }
  :global(.fixture-stage) { min-height: var(--spacing-size-small); max-width: 100%; }
  /* A fixture is drawn at its Figma frame's width (Projects is 976px), which
     the visual test needs. Here it gives way to the panel instead of running
     past it, but never below its own content: on a phone a row can't fit,
     so the panel scrolls rather than the text piling up. */
  :global(.fixture-stage > [class^='rost-']) { max-width: 100%; min-width: max-content; }
  :global(.shot) { display: block; max-width: 100%; height: auto; }
  :global(.fixture-note) { margin: var(--spacing-gap-medium-large) 0 0; color: var(--fg-3); font-size: 13.5px; }
  :global(.fixture figcaption) { font-family: var(--mono); font-size: 11px; color: var(--fg-3); }
</style>
