---
import Base from '../../layouts/Base.astro'
import ComponentGrid from '../../components/ComponentGrid.astro'
import { kit, built } from '../../lib/kit'
---
<Base title="Components · Rost" sidebar>
  <div class="kicker">Components</div>
  <h1>Everything in Rost</h1>
  <p class="lede">{kit.length} components, patterns and effects.</p>
  <p class="muted">{built.length} are built in code so far, and you can try them live. The others show Figma's own renders where I can share them, with the contract they'll be built from.</p>
  <ComponentGrid level={2} />
</Base>
