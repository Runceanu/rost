---
import Base from '../layouts/Base.astro'
import { Button } from '../../../src/components/button/Button'
import ComponentGrid from '../components/ComponentGrid.astro'
import { kit, built, tokens, GITHUB } from '../lib/kit'

const variants = kit.reduce((n, e) => n + (e.c.variants?.length ?? 0), 0)
const count = (files: Record<string, unknown>) => Object.keys(files).length
const icons = count(import.meta.glob('../../../assets/icons/*.svg'))
const illustrations = count(import.meta.glob('../../../assets/illustrations/*.svg'))
---
<Base title="Rost · My design system" description="Rost started as a design system for my own needs and grew into a product of its own. Today it serves products across different industries.">
  <section class="hero" data-paper>
    <canvas class="paper" aria-hidden="true"></canvas>
    <div class="kicker">Design system</div>
    <h1>Rost</h1>
    <p class="lede">Rost started as a design system for my own needs and grew into a product of its own. Today it serves products across different industries.</p>
    <p class="muted"><i lang="ro">Rost</i> is the Romanian word for purpose or order, in the sense that something is where it belongs.</p>
    <div class="btns">
      <Button href="/components/">Browse components</Button>
      <Button variant="secondary" href={GITHUB} target="_blank" rel="noreferrer">GitHub</Button>
    </div>
    <div class="count">
      <div><b>{kit.length}</b><span>contracts</span></div>
      <div><b>{built.length}</b><span>built in code</span></div>
      <div><b>{variants}</b><span>variants</span></div>
      <div><b>{Object.keys(tokens).length}</b><span>tokens</span></div>
    </div>
  </section>

  <h2>How it works</h2>
  <div class="steps">
    <div class="card">
      <div class="step">1</div>
      <h3>A contract</h3>
      <p>Each component is one YAML file: its parts, its tokens, every variant, how to use it, and where my apps build it. It's the source. Figma was where it started.</p>
    </div>
    <div class="card">
      <div class="step">2</div>
      <h3>Code from the contract</h3>
      <p>The CSS is written straight from the contract, so nobody types a colour by hand. The React component follows the same parts.</p>
    </div>
    <div class="card">
      <div class="step">3</div>
      <h3>Checked against Figma</h3>
      <p>Each variant of a built component is rendered in Chrome and compared with Figma's own screenshot. A wrong colour or a missing icon fails it. Text edges get a little slack, because Figma and Chrome never draw them quite the same.</p>
    </div>
  </div>

  <h2>Components</h2>
  <p class="muted">{built.length} of them are in code so far, and their cards show the real thing. The rest are contracts, and they come next, one at a time.</p>
  <ComponentGrid />

  <h2>Foundations</h2>
  <div class="grid foundations">
    <a class="card comp" href="/tokens/"><span class="comp-name">Tokens</span><span class="comp-sum">All {Object.keys(tokens).length}, with their names and values.</span></a>
    <a class="card comp" href="/icons/"><span class="comp-name">Icons and illustrations</span><span class="comp-sum">The {icons} icons and {illustrations} illustrations, as SVG.</span></a>
    <a class="card comp" href="/docs/contract/"><span class="comp-name">How a contract works</span><span class="comp-sum">What's in one, how it grows up, and how a component gets built.</span></a>
    <a class="card comp" href="/docs/roadmap/"><span class="comp-name">What's next</span><span class="comp-sum">The roadmap, in order.</span></a>
  </div>
</Base>

<script is:inline data-ids={JSON.stringify(kit.map((e) => e.id))}>
  // The old site was one long page with #badge-style anchors. Send those to
  // the new pages, but only the ones that exist.
  const known = JSON.parse(document.currentScript?.dataset.ids ?? '[]')
  const id = location.hash.slice(1)
  if (known.includes(id)) location.replace(`/components/${id}/`)
</script>

<style>
  .hero { position: relative; padding: var(--spacing-gap-large) 0 var(--spacing-gap-2xlarge); border-bottom: 1px solid var(--line); }
  .hero > :not(.paper) { position: relative; }
  /* The Paper effect, beside the words: a disc of dots, faded the way
     the portfolio site fades its own (solid to 40%, gone by 92%). It's up to 720px
     across, sized to the space between the text and the window's edge, then
     moved 280px in towards the text, and free to spill past the hero's top
     and bottom. Below 900px there's no room beside the text, so it goes. */
  .paper {
    --area: calc(100% + (var(--page-w, 100%) - 100%) / 2 - 600px);
    --d: min(720px, var(--area));
    position: absolute; pointer-events: none;
    width: var(--d); aspect-ratio: 1;
    left: calc(600px + var(--area) / 2 - var(--d) / 2 - 280px);
    top: 50%; transform: translateY(-50%);
    mask-image: radial-gradient(circle closest-side at 50% 50%, #000 40%, transparent 92%);
  }
  @media (max-width: 900px) { .paper { display: none; } }
  .steps { display: grid; gap: var(--spacing-gap-small-medium); grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
  .steps h3 { margin: var(--spacing-gap-small-medium) 0 var(--spacing-gap-small); color: var(--fg); font-family: var(--body); font-size: var(--typography-body-font-size); line-height: var(--typography-body-line-height); letter-spacing: 0; text-transform: none; font-weight: 500; }
  .steps p { margin: 0; color: var(--fg-2); font-size: 15px; }
  .step { width: var(--spacing-size-small); height: var(--spacing-size-small); border-radius: 50%; display: grid; place-items: center; font-family: var(--mono); font-size: 13px; color: var(--accent); border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent); }
  .foundations .comp { display: flex; flex-direction: column; gap: var(--spacing-gap-xsmall); text-decoration: none; transition: border-color .15s; }
  .foundations .comp:hover { border-color: color-mix(in srgb, var(--fg) 28%, transparent); }
  .foundations .comp-name { font-weight: 600; color: var(--fg); }
  .foundations .comp-sum { color: var(--fg-3); font-size: 14px; line-height: 1.45; }
</style>

<script>
  import { mountPaper } from '../../../src/effects/paper'
  const hero = document.querySelector<HTMLElement>('[data-paper]')
  const canvas = hero?.querySelector<HTMLCanvasElement>('.paper')
  // The viewport's width without its scrollbar (100vw counts it), so the
  // paper spans the page and never makes it scroll sideways.
  const fit = () => document.documentElement.style.setProperty('--page-w', `${document.documentElement.clientWidth}px`)
  fit()
  addEventListener('resize', fit)
  if (hero && canvas) mountPaper(canvas, { area: hero, buttons: hero.querySelectorAll('.rost-button'), sketches: true, ripple: true, avoid: hero.querySelectorAll('.kicker, h1, .lede, .muted, .btns, .count') })
</script>
