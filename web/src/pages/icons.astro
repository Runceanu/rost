---
import Base from '../layouts/Base.astro'
import { GITHUB, readRepo } from '../lib/kit'
import Snippet from '../components/Snippet.astro'
import { Text } from '../../../src/components/text/Text'
import { Link } from '../../../src/components/link/Link'
import { Code } from '../../../src/components/code/Code'
import { ListItem } from '../../../src/components/list-item/ListItem'
import { Disclosure } from '../../../src/components/disclosure/Disclosure'
import { Icon, ICON_NAMES } from '../../../src/components/icon/Icon'
import { Illustration, ILLUSTRATION_NAMES } from '../../../src/components/illustration/Illustration'
import { usage as iconUsage } from '../../../src/components/icon/icon.fixtures'
import { usage as illoUsage } from '../../../src/components/illustration/illustration.fixtures'
import { DRAWINGS } from '../../../src/components/illustration/drawings'

const sets = JSON.parse(readRepo('registry/component-sets.json'))
const slug = (s: string) => s.replace(/&/g, 'and').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')
const figmaIcon = Object.fromEntries(sets.icons.variants.map((v: any) => [v.name.split('/').pop(), v]))
const figmaIllo = Object.fromEntries(sets.illustrations.variants.map((v: any) => [slug(v.name.split('=')[1]), v]))
const figma = (node: string) => `https://www.figma.com/design/1Zy0wiWKXQAvsfDBX3KR0d/UI-Kit-v01?node-id=${node.replace(':', '-')}`
// The SVG as exported, without Figma's inline style and layer ids, which a caller doesn't need.
const svg = (path: string) => readRepo(path).replace(/ preserveAspectRatio="none" overflow="visible" style="display: block;"/, '').replace(/ id="[^"]*"/g, '').trim()

const icons = ICON_NAMES.map((name) => ({
  name,
  figma: figmaIcon[name],
  react: `import { Icon } from 'rost/components/icon/Icon'\n\n<Icon name="${name}" />`,
  html: `<!-- with rost/components/icon/icon.css loaded -->\n<span class="rost-icon rost-icon--name-${name} rost-icon--size-medium" aria-hidden="true"></span>`,
  svg: svg(`assets/icons/${name}.svg`),
}))
const illustrations = ILLUSTRATION_NAMES.map((name) => ({
  name,
  figma: figmaIllo[name],
  react: `import { Illustration } from 'rost/components/illustration/Illustration'\n\n<Illustration name="${name}" />`,
  html: `<!-- with rost/components/illustration/illustration.css and the tokens loaded -->\n<span class="rost-illustration" aria-hidden="true">${DRAWINGS[name]}</span>`,
  svg: svg(`assets/illustrations/${name}.svg`),
}))
const kinds = [
  { id: 'icon', title: 'Icons', items: icons, usage: iconUsage, file: 'assets/icons', blurb: ['Each one is a mask filled with the text colour, so it follows a button through its states. 24px by default; ', 'size="small"', ' is the 20px slot Button and IconButton use.'] },
  { id: 'illustration', title: 'Illustrations', items: illustrations, usage: illoUsage, file: 'assets/illustrations', blurb: ['Drawn at 72px in two greys and a green, the illustration tokens, so they follow the theme.'] },
]
---
<Base title="Icons · Rost">
  <Text variant="eyebrow" className="kicker">Foundations</Text>
  <Text variant="display" as="h1" tone="primary">Icons and illustrations</Text>
  <Text variant="lede" tone="primary" className="lede">{icons.length} icons and {illustrations.length} illustrations from Figma, each a Rost component with a contract. Pick one to see how to use it.</Text>

  {kinds.map((k) => (
    <section class="set" data-set={k.id}>
      <Text variant="sub-headline" as="h2" tone="primary">{k.title}</Text>
      <Text tone="secondary" className="blurb">{k.blurb.map((b, i) => (i % 2 ? <Code>{b}</Code> : b))}</Text>
      <div class="how">
        <Snippet code={k.usage} lang="tsx" />
        <Text variant="paragraph" className="links">
          <Link href={`/components/${k.id}/`}>The {k.id === 'icon' ? 'Icon' : 'Illustration'} contract</Link>
          <Link href={`${GITHUB}/tree/master/${k.file}`} external><Code>{k.file}/</Code> on GitHub</Link>
        </Text>
      </div>

      <!-- A list of ListItems to pick from: the picked one wears ListItem's selected plate. -->
      <ul class={`picks picks--${k.id}`} aria-label={k.title}>
        {k.items.map((i, n) => (
          <li><ListItem selected={n === 0} aria-pressed={n === 0 ? 'true' : 'false'} data-pick={i.name} leading={k.id === 'icon' ? Icon({ name: i.name as any }) : undefined}>{i.name}</ListItem></li>
        ))}
      </ul>

      {k.items.map((i, n) => (
        <div class="detail" data-detail={i.name} hidden={n !== 0}>
          <div class="big">{k.id === 'icon' ? <span class="big-icon"><Icon name={i.name as any} /></span> : <Illustration name={i.name as any} />}</div>
          <div class="info">
            <Text variant="body" as="h3" weight="medium" tone="primary"><Code>{i.name}</Code></Text>
            <Text variant="paragraph" tone="tertiary" className="meta">
              {i.figma
                ? <Link href={figma(i.figma.nodeId)} external>Figma <Code>{i.figma.name}</Code></Link>
                : <span>No frame in Figma's set yet.</span>}
              <Link href={`${GITHUB}/blob/master/${k.file}/${i.name}.svg`} external><Code>{i.name}.svg</Code></Link>
            </Text>
            <Text variant="paragraph" as="h4" weight="medium" tone="primary">React</Text>
            <Snippet code={i.react} lang="tsx" />
            <Text variant="paragraph" as="h4" weight="medium" tone="primary">HTML and CSS</Text>
            <Snippet code={i.html} lang="html" />
            <Disclosure summary="The SVG" className="svg">
              <Snippet code={i.svg} lang="svg" />
            </Disclosure>
          </div>
        </div>
      ))}
    </section>
  ))}
</Base>
<script>
  for (const set of document.querySelectorAll<HTMLElement>('.set')) {
    set.addEventListener('click', (e) => {
      const pick = (e.target as HTMLElement).closest<HTMLElement>('[data-pick]')
      if (!pick) return
      for (const t of set.querySelectorAll('[data-pick]')) {
        t.setAttribute('aria-pressed', String(t === pick))
        t.classList.toggle('rost-list-item--selected', t === pick)
      }
      for (const d of set.querySelectorAll<HTMLElement>('[data-detail]')) d.hidden = d.dataset.detail !== pick.dataset.pick
    })
  }
</script>
<style>
  .set :global(.blurb) { max-width: 70ch; }
  .how { display: grid; gap: var(--spacing-gap-small); margin: var(--spacing-gap-medium) 0 var(--spacing-gap-large); }
  .how :global(.links) { display: flex; flex-wrap: wrap; gap: var(--spacing-gap-medium); }
  .picks { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--spacing-gap-3xsmall) var(--spacing-gap-small); grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); }
  .picks li { margin: 0; min-width: 0; }
  .picks :global(.rost-list-item) { width: 100%; }
  .detail { display: grid; grid-template-columns: 200px minmax(0, 1fr); gap: var(--spacing-gap-large); margin-top: var(--spacing-gap-medium); padding: var(--spacing-gap-large); border-radius: var(--spacing-radius-large); background: var(--surface); }
  .detail[hidden] { display: none; }
  .big { display: grid; place-items: center; min-height: 200px; border-radius: var(--spacing-radius-medium); background: var(--ground); color: var(--fg); }
  .big-icon { display: contents; }
  .big-icon :global(.rost-icon) { width: 96px; height: 96px; }
  .info { min-width: 0; }
  .info :global(h3) { margin: 0; }
  .info :global(h4) { margin: var(--spacing-gap-medium) 0 var(--spacing-gap-xsmall); }
  .info :global(.meta) { display: flex; flex-wrap: wrap; gap: var(--spacing-gap-medium); margin-top: var(--spacing-gap-xsmall); }
  .info :global(.svg) { margin-top: var(--spacing-gap-medium); }
  @media (max-width: 640px) { .detail { grid-template-columns: 1fr; padding: var(--spacing-gap-medium); } .big { min-height: 140px; } }
</style>
