---
// The cards for every component, grouped by kind. Each card is Rost's own
// Thumbs, with a glimpse of the component in it. The home page and the
// components index show the same list, so it's written once.
import { Thumbs } from '../../../src/components/thumbs/Thumbs'
import Glimpse from './Glimpse.astro'
import { Text } from '../../../src/components/text/Text'
import { groups, title, inCode } from '../lib/kit'
interface Props { level?: 2 | 3 }
const { level = 3 } = Astro.props
const two = (n: number) => String(n).padStart(2, '0')
---
{groups.map(([, label, list]) => (
  <>
    <Text variant="eyebrow" as={`h${level}`} className="group-title">{label}</Text>
    <ul class="cards" role="list">
      {list.map((e, i) => (
        <li>
          <Thumbs
            className="card-thumb"
            href={`/components/${e.id}/`}
            number={two(i + 1)}
            name={title(e)}
            industry={e.c.category ?? e.kind}
            kind={inCode(e.id) ? 'In code' : 'Contract'}
            showPeriod={false}
          >
            <Glimpse id={e.id} />
          </Thumbs>
        </li>
      ))}
    </ul>
  </>
))}
<style>
  .cards { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--spacing-gap-medium); grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); }
  .cards :global(.card-thumb) { width: 100%; aspect-ratio: 384 / 334; }
  :global(.page .group-title), :global(.main .group-title) { margin: var(--spacing-gap-xlarge) 0 var(--spacing-gap-small-medium); }
</style>
