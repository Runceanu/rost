---
// A contract's guidance, drawn. Each "when to use" and "when not to use" line
// is a card with its own title and a picture: the fixture it names, or the
// component it points at in bold, or this component's own preview. Accessibility
// is a card per concern. The words are the contract's own; docs/components/*.md
// keeps them as text.
import { kit, title, mdInline, inCode, pageOf } from '../lib/kit'
import { Preview, Shot } from './Fixtures'
import { Text } from '../../../src/components/text/Text'
import { Link } from '../../../src/components/link/Link'

interface Item { title: string; text: string; show?: string }
interface Props { g: any; id: string }
const { g, id } = Astro.props
const label = (k: string) => k.replace(/([A-Z])/g, ' $1').replace(/^./, (s) => s.toUpperCase())
// "That's **IconButton**." points at another component: find it, to show it.
const byTitle = new Map(kit.map((e) => [title(e).toLowerCase(), e]))
const pointsTo = (text: string) => [...text.matchAll(/\*\*([^*]+)\*\*/g)].map((m) => byTitle.get(m[1].toLowerCase())).find((e) => e && inCode(e.id) && e.id !== id)
const cards = (list: Item[] = [], avoid = false) => list.map((x) => ({ ...x, instead: avoid && !x.show ? pointsTo(x.text) : undefined }))
const use = cards(g.use), avoid = cards(g.avoid, true)
// A table needs about 360px to read, so its cards are wider than the rest.
const wide = ['table', 'table-row', 'table-item'].includes(id)
---
{[['When to use', 'use', use], ['When not to use', 'avoid', avoid]].map(([heading, kind, list]: any) => list.length > 0 && (
  <section class="guide">
    <Text variant="sub-headline" as="h2" tone="primary">{heading}</Text>
    <ul class:list={['g-cards', { 'g-cards--wide': wide }]}>
      {list.map((c: any) => (
        <li class={`g-card g-card--pic ${kind}`}>
          {c.instead
            ? <a class="stage" href={pageOf(c.instead.id)} tabindex="-1" aria-hidden="true"><span inert><Preview id={c.instead.id} /></span></a>
            : <span class="stage" aria-hidden="true" inert>{c.show ? <Shot id={id} name={c.show} /> : <Preview id={id} />}</span>}
          <Text variant="body" as="h3" weight="medium" tone="primary" className="g-title">{c.title}</Text>
          <Text variant="paragraph" tone="secondary"><Fragment set:html={mdInline(c.text)} /></Text>
          {c.instead && <Text variant="paragraph" className="instead-name"><Link href={pageOf(c.instead.id)} tone="quiet">Use {title(c.instead)}</Link></Text>}
        </li>
      ))}
    </ul>
  </section>
))}

{g.behaviour && (
  <section class="guide">
    <Text variant="sub-headline" as="h2" tone="primary">Behaviour</Text>
    <Text tone="secondary" className="text"><Fragment set:html={mdInline(g.behaviour)} /></Text>
  </section>
)}

{g.accessibility && (
  <section class="guide">
    <Text variant="sub-headline" as="h2" tone="primary">Accessibility</Text>
    <ul class="g-cards">
      {Object.entries(g.accessibility).map(([k, v]) => <li class="g-card"><Text variant="eyebrow" as="span" className="tag">{label(k)}</Text><Text variant="paragraph" tone="secondary"><Fragment set:html={mdInline(String(v))} /></Text></li>)}
    </ul>
  </section>
)}

{g.content && (
  <section class="guide">
    <Text variant="sub-headline" as="h2" tone="primary">Content</Text>
    <Text tone="secondary" className="text"><Fragment set:html={mdInline(g.content)} /></Text>
  </section>
)}

{g.openQuestions?.length > 0 && (
  <section class="guide">
    <Text variant="sub-headline" as="h2" tone="primary">Open questions</Text>
    <ul class="g-cards">{g.openQuestions.map((x: string) => <li class="g-card"><Text variant="paragraph" tone="secondary"><Fragment set:html={mdInline(x)} /></Text></li>)}</ul>
  </section>
)}

<style>
  .guide .g-cards { list-style: none; margin: var(--spacing-gap-medium) 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: var(--spacing-gap-small); }
  .guide .g-cards--wide { grid-template-columns: repeat(auto-fill, minmax(min(100%, 400px), 1fr)); }
  .g-card { margin: 0; display: flex; flex-direction: column; gap: var(--spacing-gap-small); padding: var(--spacing-gap-medium); border-radius: var(--spacing-radius-large); background: var(--surface); min-width: 0; }
  .g-card :global(.tag) { align-self: flex-start; }
  .g-card--pic { padding-top: var(--spacing-gap-small); }
  .g-card :global(.g-title) { margin: var(--spacing-gap-2xsmall) 0 0; display: flex; align-items: center; gap: var(--spacing-gap-small); }
  /* A mark in front of the title says which list it's from, so the title doesn't have to. */
  .g-card :global(.g-title)::before { content: ""; flex: none; width: 8px; height: 8px; border-radius: 50%; background: var(--accent); }
  .avoid :global(.g-title)::before { background: var(--warn); }
  .stage { display: grid; grid-template-columns: minmax(0, 1fr); place-items: center; min-height: 120px; padding: var(--spacing-gap-medium); border-radius: var(--spacing-radius-medium); background: var(--ground); overflow-x: auto; text-decoration: none; color: inherit; }
  .stage > :global(*) { max-width: 100%; }
  .g-card :global(.instead-name) { margin-top: auto; }
  .guide :global(.text) { margin: var(--spacing-gap-small) 0 0; max-width: 70ch; }
</style>
