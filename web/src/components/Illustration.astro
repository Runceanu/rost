---
// The homepage's own illustrations, drawn in the style of Rost's circle
// illustrations (assets/illustrations): plain overlapping circles on a 72px
// grid, in their three colours, with one green circle. They assemble the way
// the portfolio site's do: each circle scales up and fades in, 0.07s apart, once,
// when its group scrolls into view (the page's script sets `data-in`).
//   contract  three parts in one column
//   code      a green circle beside the grey one it came from
//   check     a green circle dead centre in its rings
//   tokens    three circles stepping up in size: a scale
//   icons     a grid of four
//   guide     two circles with the green one where they meet
//   next      three circles stepping up and on
interface Props { name: 'contract' | 'code' | 'check' | 'tokens' | 'icons' | 'guide' | 'next'; card?: number }
const { name, card = 0 } = Astro.props
const C = { contract: [['dark', 36, 54, 12], ['mid', 36, 36, 12], ['green', 36, 18, 12]],
  code: [['mid', 24, 36, 18], ['green', 48, 36, 18]],
  check: [['dark', 36, 36, 28], ['mid', 36, 36, 19], ['green', 36, 36, 11]],
  tokens: [['dark', 10, 44, 8], ['mid', 30, 40, 12], ['green', 54, 36, 16]],
  icons: [['dark', 22, 22, 13], ['mid', 50, 22, 13], ['mid', 22, 50, 13], ['green', 50, 50, 13]],
  guide: [['mid', 24, 36, 20], ['dark', 48, 36, 20], ['green', 36, 36, 10]],
  next: [['dark', 16, 52, 12], ['mid', 34, 36, 14], ['green', 54, 18, 14]] }[name] as [string, number, number, number][]
---
<span class="ill" aria-hidden="true" style={`--card: ${card}`}>
  <svg viewBox="0 0 72 72" width="72" height="72">
    {C.map(([tone, cx, cy, r], i) => <circle class={tone} cx={cx} cy={cy} r={r} style={`--i: ${i}`} />)}
  </svg>
</span>
<style>
  /* The illustrations' own palette; the kit has no tokens for these three. */
  .ill { display: inline-grid; place-items: center; line-height: 0; }
  .dark { fill: #232423; }
  .mid { fill: #454545; opacity: .9; }
  .green { fill: #37d273; }
  circle { transform-box: fill-box; transform-origin: center; }

  /* Hidden only once the page's script has armed the group, so without
     script (or with reduced motion) they simply show. */
  :global([data-assemble][data-armed]:not([data-in])) circle { opacity: 0; }
  :global([data-assemble][data-in]) circle {
    animation: assemble .55s cubic-bezier(.34, 1.56, .64, 1) both;
    animation-delay: calc(var(--card) * .12s + var(--i) * .07s);
  }
  @keyframes assemble {
    0% { opacity: 0; transform: scale(.5); }
    60% { opacity: 1; }
    100% { transform: scale(1); }
  }
  /* The mid grey keeps its 90% once it's in. */
  :global([data-assemble][data-in]) .mid { animation-name: assemble-mid; }
  @keyframes assemble-mid {
    0% { opacity: 0; transform: scale(.5); }
    60% { opacity: .9; }
    100% { opacity: .9; transform: scale(1); }
  }
</style>
