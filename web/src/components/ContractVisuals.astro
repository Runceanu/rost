---
// The drawn parts of "How a contract works": the numbers as they are today,
// the way from a contract to code, and where each contract is in its life.
// The words stay in docs/CONTRACT.md; this only draws what they describe.
import { kit, built, inCode, title, failing, tokens, APP_LABEL } from '../lib/kit'
import { fixturesFor } from './Fixtures'

interface Props { part: 'stats' | 'pipeline' | 'lifecycle' }
const { part } = Astro.props

const tokenCount = Object.keys(tokens).length
const components = kit.filter((e) => e.kind === 'component' && inCode(e.id))
const variants = built.filter((e) => e.kind !== 'effect').reduce((n, e) => n + (fixturesFor(e.id)?.fixtures.filter((f: any) => /^\d+:\d+$/.test(f.node ?? "")).length ?? 0), 0)
const failingCount = Object.values(failing).reduce((n, list) => n + list.length, 0)
const apps = [...new Set(kit.flatMap((e) => Object.keys(e.c.implementations ?? {})))]
const stats = [
  [kit.length, 'contracts'],
  [components.length, 'components in code'],
  [tokenCount, 'tokens'],
  [`${variants - failingCount}/${variants}`, 'variants match Figma'],
  [apps.length, apps.map((a) => (APP_LABEL[a] ?? a).toLowerCase()).join(' and ')],
]

const STAGES = ['skeleton', 'draft', 'review', 'stable', 'deprecated']
const at = Object.fromEntries(STAGES.map((s) => [s, kit.filter((e) => e.c.status === s)]))
---
{part === 'stats' && (
  <ul class="stats" aria-label="Rost today">
    {stats.map(([n, label]) => <li><b>{n}</b><span>{label}</span></li>)}
  </ul>
)}

{part === 'pipeline' && (
  <figure class="flow" aria-label="From Figma to a contract, then to CSS, docs, the visual test and the apps">
    <div class="node src"><span class="k">Figma</span><span>read once, frozen 20 Oct 2026</span></div>
    <span class="arrow" aria-hidden="true"></span>
    <div class="node hub"><span class="k">Contract</span><span><code>contracts/&lt;id&gt;.contract.yaml</code></span></div>
    <span class="arrow" aria-hidden="true"></span>
    <div class="outs">
      <div class="node"><span class="k">CSS</span><span><code>npm run css</code></span></div>
      <div class="node"><span class="k">Docs</span><span>these pages, rost.build</span></div>
      <div class="node"><span class="k">Visual test</span><span>React + fixtures, against Figma at 2x</span></div>
      <div class="node"><span class="k">Apps</span><span><code>npm run add</code>, then <code>conform()</code></span></div>
    </div>
  </figure>
)}

{part === 'lifecycle' && (
  <ol class="track" aria-label="Contracts at each status">
    {STAGES.map((s) => (
      <li class={at[s].length ? 'has' : ''} data-status={s}>
        <span class="dot" aria-hidden="true"></span>
        <code>{s}</code>
        <b>{at[s].length}</b>
        {s === 'stable' && at[s].length > 0 && <span class="who">{at[s].map(title).join(', ')}</span>}
      </li>
    ))}
  </ol>
)}

<style>
  .stats { list-style: none; margin: var(--spacing-gap-large) 0 var(--spacing-gap-xlarge); padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: var(--spacing-gap-small); }
  .stats li { margin: 0; display: grid; gap: var(--spacing-gap-2xsmall); padding: var(--spacing-gap-medium); border-radius: var(--spacing-radius-large); background: var(--surface); }
  .stats b { font-size: var(--typography-sub-headline-font-size); line-height: var(--typography-sub-headline-line-height); font-weight: 500; color: var(--fg); font-variant-numeric: tabular-nums; letter-spacing: -.02em; }
  .stats span { font-size: 13px; color: var(--fg-3); }

  .flow { margin: var(--spacing-gap-medium) 0 var(--spacing-gap-large); display: grid; grid-template-columns: minmax(0, 1fr) 24px minmax(0, 1.1fr) 24px minmax(0, 1.4fr); align-items: center; gap: var(--spacing-gap-small); }
  .node { display: grid; gap: 2px; padding: var(--spacing-gap-small-medium) var(--spacing-gap-medium); border-radius: var(--spacing-radius-medium); background: var(--surface); font-size: 13px; color: var(--fg-3); min-width: 0; overflow-wrap: anywhere; }
  .node .k { font-size: 15px; font-weight: 500; color: var(--fg); }
  .hub { box-shadow: inset 0 0 0 var(--spacing-outline-small) var(--accent); }
  .hub .k { color: var(--accent); }
  .outs { display: grid; gap: var(--spacing-gap-2xsmall); }
  .arrow { height: 1px; background: var(--fg-3); position: relative; }
  .arrow::after { content: ''; position: absolute; right: 0; top: -3px; border-left: 6px solid var(--fg-3); border-block: 3.5px solid transparent; }
  @media (max-width: 760px) {
    .flow { grid-template-columns: minmax(0, 1fr); }
    .arrow { width: 1px; height: 16px; justify-self: center; }
    .arrow::after { right: -3px; top: auto; bottom: 0; border-left: 3.5px solid transparent; border-right: 3.5px solid transparent; border-top: 6px solid var(--fg-3); border-bottom: 0; }
  }

  .track { list-style: none; margin: var(--spacing-gap-medium) 0 var(--spacing-gap-large); padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); position: relative; }
  .track::before { content: ''; position: absolute; left: 6px; right: 6px; top: 6px; height: 1px; background: var(--line); }
  .track li { margin: 0; position: relative; display: grid; gap: 4px; align-content: start; padding-right: var(--spacing-gap-small); min-width: 0; }
  .track .dot { width: 13px; height: 13px; border-radius: 50%; background: var(--ground); box-shadow: inset 0 0 0 var(--spacing-outline-small) var(--fg-3); margin-bottom: var(--spacing-gap-2xsmall); }
  .track li.has .dot { background: var(--fg-3); box-shadow: none; }
  .track li[data-status="stable"].has .dot { background: var(--accent); }
  .track code { font-size: 12px; color: var(--fg-2); }
  .track b { font-size: var(--typography-title-font-size); line-height: var(--typography-title-line-height); font-weight: 500; color: var(--fg); font-variant-numeric: tabular-nums; }
  .track li:not(.has) b { color: var(--fg-3); }
  .track .who { font-size: 12px; color: var(--fg-3); line-height: 1.4; }
  @media (max-width: 560px) {
    .track { grid-template-columns: minmax(0, 1fr); gap: var(--spacing-gap-small); }
    .track::before { left: 6px; right: auto; top: 6px; bottom: 6px; width: 1px; height: auto; }
    .track li { grid-template-columns: 13px 88px 32px minmax(0, 1fr); align-items: baseline; gap: var(--spacing-gap-small); }
    .track .dot { margin: 0; align-self: center; }
  }
</style>
