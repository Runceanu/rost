---
// One component's page body: what it is, its variants, guidance, props and
// values. A contract that's part of another (a tab-item in tabs) is shown on
// that one's page, under it, with `nested`.
import Snippet from './Snippet.astro'
import Guidance from './Guidance.astro'
import { Fixtures, fixturesFor, caption } from './Fixtures'
import { byId, title, inCode, guidanceHtml, mdInline, componentSource, sourceLink, tokenCell, isColour, readRepo, APP_LABEL, GITHUB } from '../lib/kit'
import { variantTables } from '../lib/variants'
import { shotsFor } from '../lib/shots'
import { Badge } from '../../../src/components/badge/Badge'
import { Tag } from '../../../src/components/tags/Tag'
import { Tabs } from '../../../src/components/tabs/Tabs'
import { TabItem } from '../../../src/components/tab-item/TabItem'
import { Text } from '../../../src/components/text/Text'
import { Link } from '../../../src/components/link/Link'
import { Code } from '../../../src/components/code/Code'
import { Disclosure } from '../../../src/components/disclosure/Disclosure'
import { Table } from '../../../src/components/table/Table'
import { TableRow } from '../../../src/components/table-row/TableRow'
import { TableItem } from '../../../src/components/table-item/TableItem'
import { createElement as h } from 'react'

const { id, nested = false } = Astro.props as { id: string; nested?: boolean }
// Ids for the Preview/Code tabs, unique per component, since a page can show two.
const k = (s: string) => `${id}-${s}`
const e = byId(id)
const c = e.c
const g = e.guidance
const built = inCode(id)
const src = sourceLink(c)
const source = componentSource(id)
const usage = fixturesFor(id)?.usage

const { shots: figma, blanks } = built ? { shots: [], blanks: 0 } : shotsFor(id)

// The same words the markdown docs use, with a colour for each kind.
// A token is green, a suggested one amber, a gap red, the rest quiet: Text's tones.
const TONE: Record<string, 'positive' | 'warning' | 'negative' | 'tertiary'> = { token: 'positive', suggested: 'warning', layout: 'tertiary', sample: 'tertiary', reasoned: 'tertiary', gap: 'negative' }
const cell = (prop: string, v: any) => { const t = tokenCell(prop, v); return { tone: TONE[t.kind] ?? 'negative', text: t.text } }
// Never changes: one card per part. The values with a token (or missing one)
// are rows; plain layout (display, position) folds into one quiet line.
const QUIET = new Set(['layout', 'sample'])
const partsFixed = Object.entries(e.invariants).map(([part, styles]: [string, any]) => {
  const all = Object.entries(styles).map(([prop, v]: [string, any]) => ({ prop, v, kind: tokenCell(prop, v).kind }))
  return { part, rows: all.filter((r) => !QUIET.has(r.kind)), quiet: all.filter((r) => QUIET.has(r.kind)) }
})
const vt = variantTables(e.variantMap)
// Headings read like the preview captions: "Primary", "Selected · Not error".
const label = (s: string) => s.startsWith('All but ') ? `All but ${caption(s.slice(8))}` : s.includes('=') ? caption(s) : s
const contract = readRepo(`contracts/${e.file}`)

// Each app's card carries its own deviations; the ones for everyone stay below.
const apps = e.implementations.map((i: any) => ({
  ...i,
  label: APP_LABEL[i.app] ?? i.app,
  own: String(i.component ?? '').startsWith('src/rost/'),
  deviations: e.deviations.filter((d: any) => d.app === i.app),
}))
const everywhere = e.deviations.filter((d: any) => !d.app)
const initials = (s: string) => s.split(/\s+/).map((w) => w[0]).join('').slice(0, 2).toUpperCase()
const props = Object.entries(c.props ?? {}) as [string, any][]
// Props given to a React component are built with createElement: JSX inside
// an Astro attribute doesn't compile when it has expressions of its own.
const specHead = (gr: any, t: any) => h(TableRow, null,
  h(TableItem, { header: 'column', key: '' }, h('span', { className: 'sr-only' }, 'Property')),
  ...t.columns.map((col: string) => h(TableItem, { header: 'column', key: col }, caption(`${gr.column}=${col}`))))
// What a screen reader hears for each variant table.
const specLabel = (gr: any, t: any) => [title(e), gr.axes.join(' and '), t.heading && label(t.heading)].filter(Boolean).join(', ')
---
  {nested ? (
    <>
      <Text variant="eyebrow" className="kicker">Part of {title(byId(c.partOf))}</Text>
      <Text variant="sub-headline" as="h2" tone="primary" className="part-title" id={id}>{title(e)}</Text>
    </>
  ) : (
    <>
      <Text variant="eyebrow" className="kicker">{e.kind}</Text>
      <Text variant="display" as="h1" tone="primary">{title(e)}</Text>
    </>
  )}
  {c.summary && (nested
    ? <Text tone="secondary" className="muted">{c.summary}</Text>
    : <Text variant="lede" tone="primary" className="lede">{c.summary}</Text>)}
  <div class="meta">
    <Badge status={built ? 'positive' : 'default'}>{built ? 'In code' : 'Not in code yet'}</Badge>
    <Badge status={c.status === 'stable' ? 'positive' : 'default'}>Contract: {c.status}</Badge>
    <Badge status={g?.status === 'agreed' ? 'positive' : g ? 'warning' : 'default'}>Guidance: {g?.status ?? 'none yet'}</Badge>
    <Tag href={`${GITHUB}/blob/master/contracts/${e.file}`} target="_blank" rel="noreferrer">Contract on GitHub</Tag>
    {src.href && <Tag href={src.href} target="_blank" rel="noreferrer">{src.label}</Tag>}
  </div>

  <section class="tabs" data-tabs>
    <Tabs className="tab-bar" aria-label={`${title(e)} views`}>
      <TabItem selected id={k('tab-preview')} aria-controls={k('panel-preview')}>{built ? 'Preview' : 'Figma'}</TabItem>
      {built && <TabItem id={k('tab-code')} aria-controls={k('panel-code')}>Code</TabItem>}
      <TabItem id={k('tab-contract')} aria-controls={k('panel-contract')}>Contract</TabItem>
    </Tabs>
    <div class="tab-panel" role="tabpanel" id={k('panel-preview')} aria-labelledby={k('tab-preview')} tabindex="0">
      {built ? (
        <div class="stage" tabindex="0" role="region" aria-label={`${title(e)} preview`}><Fixtures id={id} /></div>
      ) : blanks > 0 && figma.length === 0 ? (
        <Text variant="paragraph" tone="tertiary" className="note">Figma's renders of this one came back empty, so there's nothing to show yet. The contract is complete. I'll capture the pictures again next time I have Figma open.</Text>
      ) : figma.length === 0 ? (
        <Text variant="paragraph" tone="tertiary" className="note">{e.kind.startsWith('effect') || e.kind === 'pattern' ? "There's no picture of this one. The contract is complete." : "Figma's renders of this one have real people's photos in them, so they stay off the site. The contract is complete."}</Text>
      ) : (
        <>
          <div class="stage">
            <div class="fixtures">
              {figma.map((v) => (
                <figure class="fixture">
                  <div class="fixture-stage"><img class="shot" src={v.url} alt={`${title(e)}, ${v.name}, as drawn in Figma`} loading="lazy" /></div>
                  <Text variant="label" as="figcaption" tone="tertiary"><Code>{caption(v.name, id)}</Code></Text>
                </figure>
              ))}
            </div>
          </div>
          <Text variant="paragraph" tone="tertiary" className="note">These are Figma's own renders. It isn't built in code yet. The contract is what I'll build it from.</Text>
        </>
      )}
    </div>
    {built && (
      <div class="tab-panel" role="tabpanel" id={k('panel-code')} aria-labelledby={k('tab-code')} tabindex="0" hidden>
        {usage && <Snippet code={usage} lang={e.kind === 'effect' ? 'css' : 'tsx'} />}
        {source && (
          <Disclosure className="source" summary={h(Code, null, source.file)}>
            <Snippet code={source.code} lang="tsx" />
          </Disclosure>
        )}
      </div>
    )}
    <div class="tab-panel" role="tabpanel" id={k('panel-contract')} aria-labelledby={k('tab-contract')} tabindex="0" hidden>
      <Text variant="paragraph" tone="tertiary" className="note contract-note">The source for everything on this page: <Link href={`${GITHUB}/blob/master/contracts/${e.file}`} external><Code>contracts/{e.file}</Code></Link>. The CSS, the docs and the checks in each app are built from it.</Text>
      <div class="contract"><Snippet code={contract} lang="yaml" /></div>
    </div>
  </section>

  {g && <Guidance g={g} id={e.id} />}

  {props.length > 0 && (
    <>
      <Text variant="sub-headline" as="h2" tone="primary">Props</Text>
      <div class="scroll" tabindex="0" role="region" aria-label={`${title(e)} props`}>
        <Table className="props" aria-label={`${title(e)} props`} head={h(TableRow, null, ...['Prop', 'Type', 'Values', 'Default'].map((x) => h(TableItem, { header: 'column', key: x }, x)))}>
          {props.map(([k, v]) => (
            <TableRow>
              <TableItem header="row"><Code>{k}</Code></TableItem>
              <TableItem><Code>{v.type}</Code></TableItem>
              <TableItem><Code>{(v.values ?? []).join(' · ')}</Code></TableItem>
              <TableItem><Code>{v.default !== undefined ? String(v.default) : ''}</Code></TableItem>
            </TableRow>
          ))}
        </Table>
      </div>
    </>
  )}
  {c.states?.length > 0 && <Text tone="secondary" className="muted states">States: {c.states.join(', ')}.</Text>}

  {apps.length > 0 && (
    <>
      <Text variant="sub-headline" as="h2" tone="primary">Where it's used</Text>
      <div class="apps">
        {apps.map((i: any) => (
          <article class="app">
            <header>
              <Text variant="label" as="span" weight="medium" tone="primary" className="avatar" aria-hidden="true">{initials(i.label)}</Text>
              <div class="app-name">
                <Text variant="body" as="b" weight="medium" tone="primary">{i.label}</Text>
                <Text variant="label" as="span" tone={i.own ? 'positive' : 'warning'} className="own">{i.own ? "Rost's own copy" : 'Its own version'}</Text>
              </div>
            </header>
            <Text variant="paragraph" as="dl" tone="secondary" className="where">
              <Text variant="paragraph" as="dt" tone="tertiary">File</Text><dd><Code>{i.component}</Code></dd>
              {i.root && <><Text variant="paragraph" as="dt" tone="tertiary">Class</Text><dd><Code>{i.root}</Code></dd></>}
            </Text>
            {i.deviations.length > 0 ? (
              <div class="diffs">
                <Text variant="label" as="span" tone="warning">Differs on purpose</Text>
                <Text variant="paragraph" as="ul" tone="secondary">{i.deviations.map((d: any) => <li><Fragment set:html={mdInline(d.what)} />{d.why && <Text variant="label" as="span" tone="tertiary" className="why"><Fragment set:html={mdInline(d.why)} /></Text>}</li>)}</Text>
              </div>
            ) : <Text variant="paragraph" tone="tertiary">Matches the contract.</Text>}
          </article>
        ))}
      </div>
    </>
  )}
  {everywhere.length > 0 && (
    <>
      <Text variant="sub-headline" as="h2" tone="primary">Where Rost differs from Figma</Text>
      <Text as="ul" tone="secondary" className="plain">{everywhere.map((d: any) => <li><Fragment set:html={mdInline(d.what)} />{' '}<Text as="span" tone="tertiary"><Fragment set:html={mdInline(d.why ?? '')} /></Text></li>)}</Text>
    </>
  )}

  <Text variant="sub-headline" as="h2" tone="primary">Values</Text>
  <Text tone="secondary" className="muted">Straight from the contract. Each value sits next to its token, because six tokens here all come out as <Code>#3a3a3a</Code> and the colour alone can't tell you which one is right.</Text>
  <Text variant="eyebrow" as="h3">Never changes</Text>
  <div class="parts">
    {partsFixed.map(({ part, rows, quiet }) => (
      <section class="part-card">
        <Text variant="body" as="h4" weight="medium" tone="primary"><Code>{part}</Code></Text>
        {rows.length > 0 && (
          <ul class="vals">
            {rows.map(({ prop, v }) => { const t = cell(prop, v); return (
              <li>
                <Text variant="label" as="span" tone="secondary" className="prop"><Code>{prop}</Code></Text>
                <Text variant="label" as="span" tone="primary" className="val">{isColour(v.value) && <span class="sw" style={`--c:${v.value}`} />}<Code>{String(v.value).replace(/\s+/g, ' ')}</Code></Text>
                <Text variant="label" as="span" tone={t.tone} className="tok"><Code>{t.text}</Code></Text>
              </li>
            ) })}
          </ul>
        )}
        {quiet.length > 0 && <Text variant="label" tone="tertiary" className="quiet">{quiet.map(({ prop, v }, n) => <>{n > 0 && ' · '}<Code>{prop} {v.value}</Code></>)}</Text>}
      </section>
    ))}
  </div>

  {vt.groups.length > 0 && (
    <>
      <Text variant="eyebrow" as="h3">Changes by variant</Text>
      <Text tone="secondary" className="muted">{vt.count} variants. Each table is what one thing changes with: a column per {vt.groups[0].column}, a row per property. Where every row starts with the same token path, it's written once, under the property.</Text>
      {vt.groups.map((gr) => (
        <section class="spec">
          <Text variant="paragraph" tone="tertiary" className="follows">Follows <Text variant="paragraph" as="b" weight="medium" tone="primary">{gr.axes.join(' and ')}</Text></Text>
          {gr.tables.map((t) => (
            <div class="spec-table">
              {t.heading && <Text variant="paragraph" weight="medium" tone="primary" className="spec-head">{label(t.heading)}</Text>}
              <div class="scroll" tabindex="0" role="region" aria-label={specLabel(gr, t)}>
                <Table className="spec-grid" style={{ '--cols': t.columns.length }} aria-label={specLabel(gr, t)} head={specHead(gr, t)}>
                  {t.rows.map((r) => (
                    <TableRow>
                      <TableItem header="row" description={r.prefix ? h(Code, null, r.prefix) : undefined}><Code>{r.key}</Code></TableItem>
                      {r.cells.map((cl) => cl ? (
                        <TableItem leading={isColour(cl.value) ? h('span', { className: 'sw', style: { '--c': cl.value } }) : undefined} description={cl.token && cl.value ? h(Code, null, cl.value) : undefined}>
                          <Text variant="label" as="span" tone={cl.token ? 'positive' : 'secondary'}><Code>{cl.token ?? cl.value}</Code></Text>
                        </TableItem>
                      ) : <TableItem><Text variant="label" as="span" tone="tertiary">·</Text></TableItem>)}
                    </TableRow>
                  ))}
                </Table>
              </div>
            </div>
          ))}
        </section>
      ))}
    </>
  )}
  {vt.only.length > 0 && (
    <>
      <Text variant="eyebrow" as="h3">Only in some variants</Text>
      <Text tone="secondary" className="muted">These don't change: they're just set in some variants and not others.</Text>
      <div class="parts">
        {vt.only.map((o) => (
          <section class="part-card">
            <Text variant="body" as="h4" weight="medium" tone="primary">{label(o.label)}</Text>
            <ul class="vals">
              {o.rows.map(({ key, v }) => { const t = cell(key.split('.')[1], v); return (
                <li>
                  <Text variant="label" as="span" tone="secondary" className="prop"><Code>{key}</Code></Text>
                  <Text variant="label" as="span" tone="primary" className="val">{isColour(v.value) && <span class="sw" style={`--c:${v.value}`} />}<Code>{String(v.value).replace(/\s+/g, ' ')}</Code></Text>
                  <Text variant="label" as="span" tone={t.tone} className="tok"><Code>{t.text}</Code></Text>
                </li>
              ) })}
            </ul>
          </section>
        ))}
      </div>
    </>
  )}

<style>
  .part-title { margin-top: 0; }
  :global(.main .part-title) { margin-top: 0; }
  .tabs { margin: var(--spacing-gap-small) 0; }
  /* The same space under the tabs for both panels. Scoped under .tabs so it
     outweighs the margin reset in Tabs' own CSS, which loads later. */
  .tabs :global(.tab-bar) { margin-bottom: var(--spacing-gap-small-medium); }
  .tabs :global(.tab-panel > pre.rost-code) { margin-top: 0; }
  .stage { background: var(--ground); border: 1px solid var(--line); border-radius: var(--spacing-radius-large); padding: var(--spacing-gap-xlarge); overflow-x: auto; }
  @media (max-width: 520px) { .stage { padding: var(--spacing-gap-medium-large); } }
  .tabs :global(.source) { margin-top: var(--spacing-gap-small-medium); }
  .tabs :global(.note) { margin: var(--spacing-gap-small) 0 0; }
  .tabs :global(.contract-note) { margin: 0 0 var(--spacing-gap-small); }
  .contract { max-height: 640px; overflow: auto; border-radius: var(--spacing-radius-medium); }
  .contract :global(pre.rost-code) { margin: 0; }
  :global(.main .plain) { padding-left: var(--spacing-gap-medium-large); overflow-wrap: anywhere; }
  :global(.main .plain li) { margin: var(--spacing-gap-2xsmall) 0; }
  :global(.main .states) { margin-top: var(--spacing-gap-small-medium); }

  /* Where it's used: a card per app. */
  .apps { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--spacing-gap-small-medium); }
  .app { display: grid; align-content: start; gap: var(--spacing-gap-medium); padding: var(--spacing-gap-medium-large); border-radius: var(--spacing-radius-large); background: var(--surface); min-width: 0; }
  .app header { display: flex; align-items: center; gap: var(--spacing-gap-small-medium); }
  .app :global(.avatar) { display: grid; place-items: center; flex-shrink: 0; width: 40px; height: 40px; border-radius: var(--spacing-radius-full); background: var(--ground); box-shadow: inset 0 0 0 1px var(--line); }
  .app-name { display: grid; gap: 2px; }
  .app :global(.own) { display: inline-flex; align-items: center; gap: 6px; }
  .app :global(.own)::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
  .app :global(.where) { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 4px var(--spacing-gap-small-medium); }
  .app :global(.where dd) { margin: 0; overflow-wrap: anywhere; }
  .diffs { border-top: 1px solid var(--line); padding-top: var(--spacing-gap-small-medium); }
  .diffs :global(ul) { margin: var(--spacing-gap-xsmall) 0 0; padding-left: var(--spacing-gap-medium); }
  .diffs :global(li) { margin: 0 0 var(--spacing-gap-xsmall); }
  .diffs :global(.why) { display: block; margin-top: 2px; }

  /* Never changes, and Only in some variants: a card per part. */
  .parts { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: var(--spacing-gap-small-medium); }
  .part-card { padding: var(--spacing-gap-medium) var(--spacing-gap-medium-large); border-radius: var(--spacing-radius-large); background: var(--surface); min-width: 0; }
  .part-card :global(h4) { margin: 0 0 var(--spacing-gap-small); }
  .vals { list-style: none; margin: 0; padding: 0; }
  .vals li { display: grid; grid-template-columns: fit-content(50%) minmax(0, 1fr); gap: 0 var(--spacing-gap-small-medium); padding: 6px 0; margin: 0; border-top: 1px solid color-mix(in srgb, var(--fg) 6%, transparent); }
  .vals li:first-child { border-top: none; }
  .vals :global(.prop) { overflow-wrap: break-word; }
  .vals :global(.val) { text-align: right; overflow-wrap: anywhere; }
  .vals :global(.tok) { grid-column: 1 / -1; overflow-wrap: anywhere; }
  .part-card :global(.quiet) { margin: var(--spacing-gap-small) 0 0; }

  /* Changes by variant: Rost's Table, a column per state. */
  .spec { margin: 0 0 var(--spacing-gap-large); }
  .spec :global(.follows) { margin: 0 0 var(--spacing-gap-small); }
  .spec-table { margin: 0 0 var(--spacing-gap-small-medium); }
  .spec-table :global(.spec-head) { margin: 0 0 var(--spacing-gap-xsmall); }
  .spec-table :global(.spec-grid) { table-layout: fixed; min-width: calc(200px + var(--cols) * 150px); }
  .spec-table :global(.spec-grid thead th:first-child) { width: 200px; }
  .spec-table :global(.spec-grid .rost-table-item) { vertical-align: top; }
  .spec-table :global(.spec-grid .sw) { margin: 0; }
  :global(.fixtures) { display: flex; flex-wrap: wrap; gap: var(--spacing-gap-large) var(--spacing-gap-2xlarge); align-items: flex-end; }
  :global(.fixture) { margin: 0; display: flex; flex-direction: column; gap: var(--spacing-gap-small); align-items: flex-start; max-width: 100%; min-width: 0; }
  :global(.fixture-stage) { min-height: var(--spacing-size-small); max-width: 100%; }
  /* A fixture is drawn at its Figma frame's width (Projects is 976px), which
     the visual test needs. Here it gives way to the panel instead of running
     past it, but never below its own content: on a phone a row can't fit,
     so the panel scrolls rather than the text piling up. */
  :global(.fixture-stage > [class^='rost-']) { max-width: 100%; min-width: max-content; }
  :global(.shot) { display: block; max-width: 100%; height: auto; }
  :global(.fixture-note) { margin: var(--spacing-gap-medium-large) 0 0; }
</style>
