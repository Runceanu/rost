---
// What a component card shows above its name: the component itself, from the
// `preview` in its fixtures file. A component that isn't in code yet says so.
// No screenshots here: a card shows Rost, or nothing.
import { Preview, fixturesFor } from './Fixtures'

interface Props { id: string }
const { id } = Astro.props
const built = Boolean(fixturesFor(id)?.preview)
---
<span class="glimpse" aria-hidden="true" inert>
  {built ? <Preview id={id} /> : <span class="later">Not in code yet</span>}
</span>
<style>
  .glimpse { position: absolute; inset: 0 0 112px; display: flex; align-items: center; justify-content: center; padding: var(--spacing-gap-medium); overflow: hidden; }
  .later { font-family: var(--mono); font-size: 11px; letter-spacing: .09em; text-transform: uppercase; color: var(--fg-3); }
</style>
