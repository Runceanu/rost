{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rost",
  "compatibility_date": "2026-10-19",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "web/dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "rost.build",
      "custom_domain": true
    }
  ],
  "workers_dev": true
}
