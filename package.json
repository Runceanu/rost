{
  "name": "rost",
  "version": "0.1.0",
  "description": "Rost: a design system that grew into a product of its own. Contracts, tokens and components, serving products across different industries.",
  "type": "module",
  "private": true,
  "exports": {
    "./tokens.css": "./tokens/tokens.css",
    "./tokens.json": "./tokens/tokens.json",
    "./contracts/*": "./contracts/*",
    "./registry/*": "./registry/*",
    "./conform": "./src/conform.ts",
    "./schema/*": "./schema/*",
    "./components/*": "./src/components/*"
  },
  "bin": {
    "rost-audit": "./bin/audit.mjs"
  },
  "scripts": {
    "add": "node bin/add.mjs",
    "audit": "node bin/audit.mjs",
    "docs": "node bin/validate.mjs && node bin/build-docs.mjs",
    "build:contracts": "node bin/build-contracts.mjs",
    "validate": "node bin/validate.mjs",
    "site": "npm run docs && astro build --root web",
    "deploy": "npm run site && wrangler deploy",
    "preview": "wrangler dev",
    "css": "node bin/build-css.mjs",
    "test:visual": "node bin/visual-test.mjs",
    "site:dev": "astro dev --root web --port 4321",
    "site:preview": "astro preview --root web --port 4321"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/react": "4.4.2",
    "astro": "5.18.2",
    "esbuild": "0.28.2",
    "marked": "18.1.1",
    "pixelmatch": "8.0.0",
    "playwright": "1.64.1",
    "pngjs": "7.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "wrangler": "4.151.2"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "homepage": "https://rost.build",
  "repository": {
    "type": "git",
    "url": "https://github.com/Runceanu/rost.git"
  }
}
