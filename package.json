{
  "name": "rost",
  "version": "0.1.0",
  "description": "Rost: a design system that grew into a product of its own. Contracts, tokens and components, serving products across different industries.",
  "type": "module",
  "keywords": [
    "design-system",
    "react",
    "components",
    "design-tokens",
    "shadcn",
    "registry"
  ],
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin/rost.mjs",
    "bin/audit.mjs",
    "tokens/",
    "contracts/",
    "schema/",
    "registry/figma-variables.json",
    "src/conform.ts",
    "src/assets.d.ts",
    "src/components/",
    "!src/components/**/*.fixtures.tsx",
    "README.md"
  ],
  "exports": {
    "./tokens.css": "./tokens/tokens.css",
    "./fonts.css": "./tokens/fonts.css",
    "./tokens.json": "./tokens/tokens.json",
    "./contracts/*": "./contracts/*",
    "./conform": "./src/conform.ts",
    "./schema/*": "./schema/*",
    "./components/*": "./src/components/*"
  },
  "bin": {
    "rost": "./bin/rost.mjs",
    "rost-audit": "./bin/audit.mjs"
  },
  "scripts": {
    "add": "node bin/add.mjs",
    "audit": "node bin/audit.mjs",
    "docs": "node bin/validate.mjs && node bin/build-docs.mjs",
    "build:contracts": "node bin/build-contracts.mjs",
    "validate": "node bin/validate.mjs && node bin/build-tokens.mjs --check",
    "tokens": "node bin/build-tokens.mjs",
    "illustrations": "node bin/build-illustrations.mjs",
    "site": "npm run docs && astro build --root web",
    "deploy": "npm run site && wrangler deploy",
    "preview": "wrangler dev",
    "css": "node bin/build-css.mjs",
    "test:visual": "node bin/visual-test.mjs",
    "site:dev": "astro dev --root web --port 4321",
    "site:preview": "astro preview --root web --port 4321",
    "pen": "node bin/build-pen.mjs",
    "pen:site": "npm run site && node bin/build-pen-pages.mjs web dist ../design/rost-build.pen --all"
  },
  "devDependencies": {
    "@astrojs/react": "4.4.2",
    "ajv": "8.20.0",
    "astro": "5.18.2",
    "axe-core": "^4.14.0",
    "esbuild": "0.28.2",
    "marked": "18.1.1",
    "pixelmatch": "8.0.0",
    "playwright": "1.64.1",
    "pngjs": "7.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "wrangler": "4.151.2",
    "yaml": "2.9.1"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "homepage": "https://rost.build",
  "repository": {
    "type": "git",
    "url": "https://github.com/Runceanu/rost.git"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
